<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Apna Sahara - Home Page</title>
<style>
  :root{
    --purple: #6C3FE0;
    --purple-dark: #4F2BB8;
    --purple-light: #EDE7FB;
    --ink: #1F1B2E;
    --gray: #6B7280;
    --gray-light: #9CA3AF;
    --green: #22A559;
    --orange: #F5821F;
    --blue: #2E7CF6;
    --red: #E14B4B;
    --border: #ECEAF3;
    --bg-soft: #F7F6FC;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html{ scroll-behavior:smooth; }
  body{
    font-family: 'Segoe UI', system-ui, -apple-system, Roboto, Helvetica, Arial, sans-serif;
    color: var(--ink);
    background: #fff;
    -webkit-font-smoothing: antialiased;
  }
  a{ text-decoration:none; color:inherit; }
  ul{ list-style:none; }
  img{ max-width:100%; display:block; }
  button{ font-family:inherit; }
  section{ scroll-margin-top: 90px; }

  /* ---------- Header ---------- */
  header{
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding: 18px 40px;
    border-bottom: 1px solid var(--border);
    position: sticky;
    top:0;
    background:#fff;
    z-index: 100;
  }
  .logo{ display:flex; align-items:center; gap:10px; }
  .logo-icon{
    width:38px; height:38px;
    background: var(--purple);
    border-radius: 10px;
    display:flex; align-items:center; justify-content:center;
    flex-shrink:0;
  }
  .logo-icon svg{ width:20px; height:20px; }
  .logo-text .title{ font-weight:700; font-size: 1.05rem; color: var(--ink); line-height:1.1; }
  .logo-text .subtitle{ font-size: 0.7rem; color: var(--gray); }

  nav.main-nav{ display:flex; gap: 32px; }
  nav.main-nav a{
    font-size: 0.92rem; font-weight:500; color: var(--ink);
    position:relative; padding-bottom: 4px; cursor:pointer;
  }
  nav.main-nav a:hover{ color: var(--purple); }
  nav.main-nav a.active{ color: var(--purple); }
  nav.main-nav a.active::after{
    content:""; position:absolute; left:0; right:0; bottom:-18px; height:2px; background: var(--purple);
  }

  .header-actions{ display:flex; align-items:center; gap: 12px; }
  .btn{
    display:inline-flex; align-items:center; justify-content:center; gap:8px;
    padding: 10px 20px; border-radius: 999px; font-size: 0.9rem; font-weight:600;
    cursor:pointer; border: 1.5px solid transparent; white-space:nowrap; transition: all .18s ease;
  }
  .btn svg{ width:16px; height:16px; flex-shrink:0; }
  .btn-outline{ border-color: var(--purple); color: var(--purple); background:#fff; }
  .btn-outline:hover{ background: var(--purple-light); }
  .btn-solid{ background: var(--purple); color:#fff; }
  .btn-solid:hover{ background: var(--purple-dark); }
  .btn-block{ width:100%; }

  .menu-toggle{ display:none; flex-direction:column; gap:5px; background:none; border:none; cursor:pointer; padding: 6px; }
  .menu-toggle span{ width:24px; height:2.5px; background: var(--ink); border-radius:2px; }

  /* ---------- Hero ---------- */
  .hero{ background: linear-gradient(180deg, #FAFAFD 0%, #FFFFFF 100%); overflow:hidden; }
  .hero-inner{
    display:grid; grid-template-columns: 1fr 1.15fr; align-items:center; gap: 40px;
    padding: 70px 40px 60px; max-width: 1280px; margin:0 auto;
  }
  .hero .eyebrow{ color: var(--purple); font-weight:600; font-size: 0.95rem; margin-bottom: 14px; }
  .hero h1{ font-size: 3.1rem; line-height: 1.12; font-weight: 800; letter-spacing: -0.5px; }
  .hero h1 .accent{ color: var(--purple); }
  .hero p{ margin-top: 20px; color: var(--gray); font-size: 1.05rem; line-height: 1.6; max-width: 440px; }
  .hero-ctas{ margin-top: 30px; display:flex; gap: 16px; flex-wrap:wrap; }
  .hero-ctas .btn{ padding: 14px 26px; font-size: 0.95rem; }
  .hero-media{ position:relative; border-radius: 24px; overflow:hidden; aspect-ratio: 4/3; background: linear-gradient(135deg, #EDE7FB, #F7F1E8); }
  .hero-media img{ width:100%; height:100%; object-fit:cover; display:block; }

  /* ---------- Section heading pattern ---------- */
  .section{ padding: 80px 40px; max-width: 1280px; margin: 0 auto; }
  .section.alt{ background: var(--bg-soft); max-width:none; }
  .section.alt > .inner{ max-width:1280px; margin:0 auto; padding:80px 40px; }
  .section-head{ text-align:center; margin-bottom: 44px; }
  .section-head .eyebrow{ color: var(--purple); font-weight:700; font-size: 0.82rem; letter-spacing:0.03em; text-transform:uppercase; margin-bottom:10px; }
  .section-head h2{ font-size: 2.1rem; font-weight:800; }
  .section-head .underline{ width: 60px; height: 4px; background: var(--purple); border-radius: 4px; margin: 14px auto 16px; }
  .section-head p{ color: var(--gray); font-size: 1rem; max-width:560px; margin:0 auto; }

  /* ---------- Cards ---------- */
  .card{ border: 1px solid var(--border); border-radius: 16px; transition: box-shadow .2s ease, transform .2s ease; background:#fff; }
  .card:hover{ box-shadow: 0 12px 30px rgba(108,63,224,0.1); transform: translateY(-3px); }

  /* ---------- Feature cards (Why Donate) ---------- */
  .features{ display:grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
  .feature-card{ padding: 32px 22px; text-align:center; }
  .feature-icon{ width: 56px; height:56px; border-radius: 50%; display:flex; align-items:center; justify-content:center; margin: 0 auto 18px; }
  .feature-icon svg{ width:26px; height:26px; }
  .feature-icon.purple{ background: var(--purple-light); }
  .feature-icon.green{ background: #E4F7EA; }
  .feature-icon.orange{ background: #FDEBE0; }
  .feature-icon.blue{ background: #E4EEFE; }
  .feature-card h3{ font-size: 1.05rem; font-weight:700; margin-bottom: 10px; }
  .feature-card p{ color: var(--gray); font-size: 0.9rem; line-height:1.55; }

  /* ---------- Stats bar ---------- */
  .stats{
    background: var(--bg-soft); border-radius: 20px; padding: 36px 30px;
    display:grid; grid-template-columns: repeat(4, 1fr); gap: 20px;
  }
  .stat{ display:flex; align-items:center; gap:16px; padding: 0 20px; position:relative; }
  .stat:not(:last-child)::after{ content:""; position:absolute; right:0; top:50%; transform: translateY(-50%); height: 44px; width:1px; background: #E1DEEE; }
  .stat-icon{ width: 52px; height:52px; border-radius:50%; flex-shrink:0; display:flex; align-items:center; justify-content:center; }
  .stat-icon svg{ width:24px; height:24px; }
  .stat-icon.purple{ background: var(--purple); }
  .stat-icon.green{ background: var(--green); }
  .stat-icon.orange{ background: var(--orange); }
  .stat-icon.blue{ background: var(--blue); }
  .stat-num{ font-size: 1.5rem; font-weight:800; line-height:1.1; }
  .stat-num.c-purple{ color: var(--purple); }
  .stat-num.c-green{ color: var(--green); }
  .stat-num.c-orange{ color: var(--orange); }
  .stat-num.c-blue{ color: var(--blue); }
  .stat-label{ color: var(--gray); font-size: 0.85rem; margin-top: 2px; }

  /* ---------- Search / Filter bar ---------- */
  .search-filter{ display:flex; gap: 16px; flex-wrap:wrap; align-items:center; margin-bottom: 40px; }
  .search-box{
    flex:1; min-width: 240px; display:flex; align-items:center; gap:10px;
    background:#fff; border: 1.5px solid var(--border); border-radius: 14px; padding: 12px 18px;
  }
  .search-box svg{ width:18px; height:18px; color: var(--gray-light); flex-shrink:0; }
  .search-box input{ border:none; outline:none; width:100%; font-size:0.92rem; font-family:inherit; }
  .filter-chips{ display:flex; gap:10px; flex-wrap:wrap; }
  .chip{ padding: 10px 18px; border-radius: 999px; border: 1.5px solid var(--border); background:#fff; font-size: 0.85rem; font-weight:600; color: var(--gray); cursor:pointer; white-space:nowrap; }
  .chip.active{ background: var(--purple); border-color: var(--purple); color:#fff; }

  /* ---------- Organizations grid ---------- */
  .org-grid{ display:grid; grid-template-columns: repeat(3, 1fr); gap: 26px; }
  .org-card{ padding: 26px; display:flex; flex-direction:column; }
  .org-top{ display:flex; align-items:center; gap:14px; margin-bottom:16px; }
  .org-logo{ width:52px; height:52px; border-radius:14px; display:flex; align-items:center; justify-content:center; font-weight:800; color:#fff; font-size:1.1rem; flex-shrink:0; }
  .org-name-wrap{ flex:1; min-width:0; }
  .org-name{ font-weight:700; font-size:1rem; display:flex; align-items:center; gap:6px; }
  .org-name svg{ width:15px; height:15px; flex-shrink:0; }
  .org-cat{ font-size:0.8rem; color: var(--gray); margin-top:2px; }
  .org-desc{ color: var(--gray); font-size:0.88rem; line-height:1.6; margin-bottom:18px; flex:1; }
  .progress-track{ height:7px; background: var(--border); border-radius:999px; overflow:hidden; margin-bottom:8px; }
  .progress-fill{ height:100%; background: var(--purple); border-radius:999px; }
  .progress-labels{ display:flex; justify-content:space-between; font-size:0.78rem; color: var(--gray); margin-bottom:18px; }
  .progress-labels b{ color: var(--ink); }
  .org-actions{ display:flex; gap:10px; }
  .org-actions .btn{ flex:1; padding:10px 14px; font-size:0.85rem; }

  /* ---------- Categories grid ---------- */
  .cat-grid{ display:grid; grid-template-columns: repeat(3 , 1fr); gap: 24px; }
  .cat-card{ padding: 30px 24px; text-align:center; }
  .cat-icon{ width:60px; height:60px; border-radius:16px; display:flex; align-items:center; justify-content:center; margin: 0 auto 18px; }
  .cat-icon svg{ width:28px; height:28px; }
  .cat-card h3{ font-size:1.02rem; font-weight:700; margin-bottom:8px; }
  .cat-card p{ color: var(--gray); font-size:0.86rem; line-height:1.55; margin-bottom:14px; }
  .cat-count{ font-size:0.78rem; font-weight:700; color: var(--purple); }

  /* ---------- About ---------- */
  .about-grid{ display:grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items:center; margin-bottom: 70px; }
  .about-grid img{ border-radius:20px; width:100%; aspect-ratio: 4/3; object-fit:cover; }
  .about-grid h3{ font-size:1.7rem; font-weight:800; margin-bottom:18px; }
  .about-grid p{ color: var(--gray); line-height:1.75; margin-bottom:14px; }

  .values-grid{ display:grid; grid-template-columns: repeat(3,1fr); gap:24px; margin-bottom:70px; }
  .value-card{ padding:28px 24px; text-align:center; }
  .value-card .feature-icon{ margin-bottom:16px; }
  .value-card h3{ font-size:1rem; font-weight:700; margin-bottom:8px; }
  .value-card p{ color:var(--gray); font-size:0.88rem; line-height:1.55; }

  .team-grid{ display:grid; grid-template-columns: repeat(3,1fr); gap:24px; }
  .team-card{ text-align:center; padding: 24px 18px; }
  .team-avatar{ width:88px; height:88px; border-radius:50%; margin:0 auto 16px; }
  .team-card h4{ font-size:0.95rem; font-weight:700; }
  .team-card span{ font-size:0.8rem; color: var(--purple); font-weight:600; }
  .sub-head{ text-align:center; font-size:1.3rem; font-weight:800; margin-bottom:36px; }

  /* ---------- How it works ---------- */
  .steps-wrap{ max-width: 800px; margin: 0 auto 70px; }
  .step-row{ display:flex; gap:28px; margin-bottom: 44px; position:relative; }
  .step-row:last-child{ margin-bottom:0; }
  .step-num{
    width:56px; height:56px; border-radius:50%; background: var(--purple); color:#fff;
    font-weight:800; font-size:1.2rem; display:flex; align-items:center; justify-content:center;
    flex-shrink:0; position:relative; z-index:1;
  }
  .step-row:not(:last-child)::before{ content:""; position:absolute; left:27px; top:56px; bottom:-44px; width:2px; background: var(--border); }
  .step-body h3{ font-size:1.1rem; font-weight:700; margin-bottom:8px; }
  .step-body p{ color: var(--gray); font-size:0.92rem; line-height:1.65; max-width:520px; }

  .faq-wrap{ max-width: 800px; margin:0 auto; }
  .faq-item{ border-bottom: 1px solid var(--border); padding: 20px 0; }
  .faq-item summary{ font-weight:700; cursor:pointer; font-size:0.98rem; list-style:none; display:flex; justify-content:space-between; align-items:center; }
  .faq-item summary::-webkit-details-marker{ display:none; }
  .faq-item summary::after{ content:"+"; font-size:1.3rem; color: var(--purple); font-weight:400; }
  .faq-item[open] summary::after{ content:"\2212"; }
  .faq-item p{ color: var(--gray); font-size:0.9rem; margin-top:12px; line-height:1.65; }

  /* ---------- Contact ---------- */
  .contact-wrap{ display:grid; grid-template-columns: 0.9fr 1.3fr; gap: 40px; }
  .contact-info-card{ padding: 30px 26px; margin-bottom: 20px; }
  .contact-info-card .stat-icon{ margin-bottom:14px; }
  .contact-info-card h4{ font-size:0.95rem; font-weight:700; margin-bottom:6px; }
  .contact-info-card p{ font-size:0.88rem; color: var(--gray); line-height:1.6; }
  .contact-form-card{ padding: 36px; }
  .contact-form-card h3{ font-size:1.4rem; font-weight:800; margin-bottom:8px; }
  .contact-form-card > p{ color: var(--gray); font-size:0.9rem; margin-bottom:26px; }

  /* ---------- Forms ---------- */
  .form-group{ margin-bottom: 20px; }
  .form-group label{ display:block; font-size: 0.86rem; font-weight:600; margin-bottom: 8px; }
  .form-group input, .form-group textarea{
    width:100%; padding: 12px 16px; border: 1.5px solid var(--border); border-radius: 10px;
    font-size: 0.92rem; font-family: inherit; color: var(--ink); background:#fff; transition: border-color .15s ease;
  }
  .form-group input:focus, .form-group textarea:focus{ outline:none; border-color: var(--purple); }
  .form-group textarea{ resize:vertical; min-height: 120px; }
  .form-row{ display:grid; grid-template-columns: 1fr 1fr; gap:20px; }

  /* ---------- Footer ---------- */
  footer.site-footer{ background: #1B1730; color: #C9C4DD; padding: 60px 40px 0; }
  .footer-grid{ max-width: 1280px; margin: 0 auto; display:grid; grid-template-columns: 1.4fr 1fr 1fr 1.2fr; gap: 40px; padding-bottom: 40px; }
  .footer-grid h4{ color:#fff; font-size: 0.95rem; margin-bottom: 18px; }
  .footer-grid p{ font-size: 0.88rem; line-height:1.7; }
  .footer-grid ul li{ margin-bottom: 10px; }
  .footer-grid ul li a{ font-size: 0.88rem; }
  .footer-grid ul li a:hover{ color:#fff; }
  .footer-logo{ display:flex; align-items:center; gap:10px; margin-bottom: 14px; }
  .footer-bottom{ border-top: 1px solid rgba(255,255,255,0.08); padding: 20px 0; max-width: 1280px; margin: 0 auto; text-align:center; font-size: 0.8rem; color: #8B85A6; }
  .social-row{ display:flex; gap:10px; margin-top:16px; }
  .social-row a{ width:34px; height:34px; border-radius:50%; background: rgba(255,255,255,0.08); display:flex; align-items:center; justify-content:center; }
  .social-row a svg{ width:15px; height:15px; }
  .social-row a:hover{ background: var(--purple); }

  /* ---------- Responsive ---------- */
  @media (max-width: 1024px){
    .hero-inner{ grid-template-columns: 1fr; }
    .hero-media{ order:-1; aspect-ratio: 16/9; }
    .hero h1{ font-size: 2.5rem; }
    .features{ grid-template-columns: repeat(2, 1fr); }
    .stats{ grid-template-columns: repeat(2, 1fr); }
    .stat:nth-child(2)::after{ display:none; }
    .org-grid{ grid-template-columns: repeat(2,1fr); }
    .cat-grid{ grid-template-columns: repeat(2,1fr); }
    .about-grid{ grid-template-columns:1fr; gap:30px; }
    .values-grid{ grid-template-columns: repeat(2,1fr); }
    .team-grid{ grid-template-columns: repeat(2,1fr); }
    .contact-wrap{ grid-template-columns:1fr; }
    .footer-grid{ grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 860px){
    nav.main-nav{
      position:absolute; top: 100%; left:0; right:0; background:#fff;
      flex-direction:column; padding: 20px 40px; gap: 18px;
      border-bottom: 1px solid var(--border); display:none;
      box-shadow: 0 10px 20px rgba(0,0,0,0.04);
    }
    nav.main-nav.open{ display:flex; }
    nav.main-nav a.active::after{ display:none; }
    .menu-toggle{ display:flex; }
    header{ position:relative; flex-wrap:wrap; }
    .header-actions .btn-outline{ display:none; }
  }

  @media (max-width: 640px){
    header, .hero-inner, .section, .section.alt > .inner{ padding-left:20px; padding-right:20px; }
    .hero-inner{ padding-top: 40px; padding-bottom: 40px; }
    .hero h1{ font-size: 2rem; }
    .hero p{ font-size: 0.95rem; }
    .features{ grid-template-columns: 1fr; }
    .stats{ grid-template-columns: 1fr; }
    .stat::after{ display:none; }
    .section-head h2{ font-size: 1.7rem; }
    .org-grid{ grid-template-columns: 1fr; }
    .cat-grid{ grid-template-columns: 1fr; }
    .values-grid{ grid-template-columns: 1fr; }
    .team-grid{ grid-template-columns: 1fr 1fr; }
    .footer-grid{ grid-template-columns: 1fr; }
    .header-actions{ gap: 8px; }
    .btn{ padding: 9px 16px; font-size: 0.85rem; }
  }
</style>
</head>
<body>

<header>
  <a class="logo" href="#home">
    <div class="logo-icon">
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M12 21s-7.5-4.6-10-9.1C.5 8.4 2.4 5 6 5c2 0 3.6 1.1 4.5 2.6C11.4 6.1 13 5 15 5c3.6 0 5.5 3.4 4 6.9C19.5 16.4 12 21 12 21z" stroke="white" stroke-width="1.8" stroke-linejoin="round"/>
        <path d="M9 12l2 2 4-4" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
    <div class="logo-text">
      <div class="title">Apna Sahara</div>
      <!-- <div class="subtitle">Donation Management</div> -->
    </div>
  </a>

  <nav class="main-nav" id="mainNav">
    <a href="#home" class="nav-link active" data-target="home">Home</a>
    <a href="#organizations" class="nav-link" data-target="organizations">Organizations</a>
    <a href="#categories" class="nav-link" data-target="categories">Categories</a>
    <a href="#about" class="nav-link" data-target="about">About Us</a>
    <a href="#how-it-works" class="nav-link" data-target="how-it-works">How It Works</a>
    <a href="#contact" class="nav-link" data-target="contact">Contact Us</a>
  </nav>

  <div class="header-actions">
    <a class="btn btn-outline" href="/login">
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M10 17l5-5-5-5M15 12H3M15 5h4a2 2 0 012 2v10a2 2 0 01-2 2h-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      Login
    </a>
    <a class="btn btn-solid" href="/register">
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M16 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2M8.5 11a4 4 0 100-8 4 4 0 000 8zM20 8v6M23 11h-6" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      Register
    </a>
    <button class="menu-toggle" id="menuToggle" aria-label="Toggle menu">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<!-- ============ HOME / HERO ============ -->
<section class="hero" id="home">
  <div class="hero-inner">
    <div>
      <div class="eyebrow">Your kindness can change someone’s world</div>
      <h1>Changing Lives Through Kindness.<br></h1>
      <p>Your donation can bring smiles, hope, and a better tomorrow to those who need it most.</p>
      <div class="hero-ctas">
        <a class="btn btn-solid" href="#organizations">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 21s-7.5-4.6-10-9.1C.5 8.4 2.4 5 6 5c2 0 3.6 1.1 4.5 2.6C11.4 6.1 13 5 15 5c3.6 0 5.5 3.4 4 6.9C19.5 16.4 12 21 12 21z" stroke="white" stroke-width="2" stroke-linejoin="round"/></svg>
          Make a Donation
        </a>
        <a class="btn btn-outline" href="#organizations">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2M9 11a4 4 0 100-8 4 4 0 000 8zM23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          View Organizations
        </a>
      </div>
    </div>
    <div class="hero-media">
      <img src="https://images.unsplash.com/photo-1562709902-31c9a3b1ad5c?fm=jpg&amp;q=80&amp;w=1200&amp;auto=format&amp;fit=crop" alt="Two people exchanging a donation of fresh fruit, hand to hand" loading="eager">
    </div>
  </div>
</section>

<!-- ============ WHY DONATE ============ -->
<section class="section">
  <div class="section-head">
    <h2>Why Donate With Us?</h2>
    <div class="underline"></div>
    <p>We make sure your kindness creates the biggest impact.</p>
  </div>
  <div class="features">
