<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Profile - Apna Sahara</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.4/chart.umd.min.js"></script>

    <style>
        :root {
            --navy: #111a3d;
            --purple: #6f5bf0;
            --purple-light: #eeeafd;
            --blue: #2f7bf6;
            --blue-light: #e7f0fe;
            --amber: #f5a623;
            --amber-light: #fdf1de;
            --green: #28b463;
            --green-light: #e6f7ec;
            --pink: #e0447a;
            --pink-light: #fbe7ef;
            --teal: #17b697;
            --gray: #8b93a7;
            --gray-light: #eef0f4;
            --text-dark: #1c2333;
            --text-mid: #5b6478;
            --text-light: #8b93a7;
            --border: #eef0f4;
            --bg: #f5f6fa;
            --white: #ffffff;
            --radius: 14px;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--bg);
            color: var(--text-dark);
            display: flex;
            min-height: 100vh;
        }

        button {
            font-family: inherit;
        }

        /* ===== SIDEBAR ===== */
        .sidebar-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(10, 13, 30, 0.5);
            z-index: 1000;
        }

        .sidebar-overlay.open {
            display: block;
        }

        .sidebar {
            width: 264px;
            background: var(--navy);
            color: #cfd3e6;
            display: flex;
            flex-direction: column;
            padding: 22px 18px;
            flex-shrink: 0;
            transition: transform .28s ease;
            z-index: 1001;
            max-height: 100vh;
            overflow-y: auto;
        }

        .sidebar-close {
            display: none;
            align-self: flex-end;
            font-size: 20px;
            color: #9aa1c2;
            background: none;
            border: none;
            cursor: pointer;
            margin-bottom: 4px;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 0 6px 22px 6px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            margin-bottom: 18px;
        }

        .brand-icon {
            width: 42px;
            height: 42px;
            background: #fff;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            flex-shrink: 0;
        }

        .brand-text h1 {
            font-size: 15px;
            color: #fff;
            font-weight: 700;
            line-height: 1.3;
        }

        .brand-text p {
            font-size: 12px;
            color: #9aa1c2;
        }

        .menu-label {
            font-size: 11px;
            letter-spacing: 0.06em;
            color: #7981a6;
            font-weight: 700;
            margin: 14px 10px 8px;
        }

        nav {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 11px 14px;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 500;
            color: #c3c8de;
            cursor: pointer;
            transition: background .15s ease;
            position: relative;
        }

        .nav-item a {
            color: white;
            text-decoration: none;
        }

        .nav-item:hover {
            background: rgba(255, 255, 255, 0.06);
        }

        .nav-item.active {
            background: var(--purple);
            color: #fff;
            font-weight: 600;
        }

        .nav-icon {
            width: 20px;
            text-align: center;
            flex-shrink: 0;
        }

        /* ===== MAIN ===== */
        .main {
            flex: 1;
            display: flex;
            flex-direction: column;
            min-width: 0;
        }

        .topbar {
            background: var(--white);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 16px 32px;
            border-bottom: 1px solid var(--border);
            position: relative;
            z-index: 50;
        }

        .top-left {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .hamburger {
            font-size: 20px;
            color: var(--text-mid);
            cursor: pointer;
        }

        .top-title {
            font-size: 19px;
            font-weight: 800;
            color: var(--text-dark);
        }

        .top-right {
            display: flex;
            align-items: center;
            gap: 22px;
            position: relative;
        }

        .bell-wrap {
            position: relative;
            font-size: 19px;
            color: var(--text-mid);
            cursor: pointer;
        }

        .bell-dot {
            position: absolute;
            top: -6px;
            right: -8px;
            background: #e0447a;
            color: #fff;
            font-size: 10px;
            font-weight: 700;
            width: 16px;
            height: 16px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .dropdown-panel {
            position: absolute;
            top: calc(100% + 14px);
            right: 0;
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(20, 20, 50, 0.15);
            width: 290px;
            padding: 8px 0;
            display: none;
            z-index: 100;
        }

        .dropdown-panel.open {
            display: block;
        }

        .dropdown-title {
            font-size: 13px;
            font-weight: 700;
            padding: 10px 16px;
            border-bottom: 1px solid var(--border);
        }

        .notif-item {
            padding: 11px 16px;
            border-bottom: 1px solid var(--border);
            cursor: pointer;
        }

        .notif-item:hover {
            background: #fafafc;
        }

        .notif-item:last-child {
            border-bottom: none;
        }

        .notif-item p {
            font-size: 12.5px;
            color: var(--text-dark);
            font-weight: 600;
            margin-bottom: 2px;
        }

        .notif-item span {
            font-size: 11.5px;
            color: var(--text-light);
        }

        .user-block {
            display: flex;
            align-items: center;
            gap: 10px;
            cursor: pointer;
        }

        .avatar {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: var(--purple);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 14px;
            overflow: hidden;
        }

        .avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .user-name {
            font-size: 14px;
            font-weight: 700;
            color: var(--text-dark);
        }

        .user-role {
            font-size: 12px;
            color: var(--text-light);
        }

        .chev {
            color: var(--text-light);
            font-size: 11px;
            margin-left: 2px;
        }

        .user-menu {
            width: 180px;
        }

        .user-menu-item {
            padding: 11px 16px;
            font-size: 13px;
            font-weight: 600;
            color: var(--text-dark);
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .user-menu-item a {
            text-decoration: none;
        }

        .user-menu-item:hover {
            background: #fafafc;
        }

        .user-menu-item.danger {
            color: #e0447a;
        }

        .content {
            padding: 26px 32px 40px;
            width: 100%;
        }

        /* ===== PAGE HEADER ===== */
        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 20px;
            flex-wrap: wrap;
            gap: 14px;
        }

        .page-header h1 {
            font-size: 26px;
            font-weight: 800;
            margin-bottom: 6px;
        }

        .breadcrumb {
            font-size: 13.5px;
            color: var(--text-light);
        }

        .breadcrumb span {
            color: var(--text-dark);
            font-weight: 600;
        }

        .header-actions {
            display: flex;
            gap: 12px;
        }

        .btn-outline-purple {
            display: flex;
            align-items: center;
            gap: 8px;
            background: #fff;
            color: var(--text-dark);
            border: 1.5px solid #d8dbe6;
            font-size: 13.5px;
            font-weight: 700;
            padding: 11px 18px;
            border-radius: 9px;
            cursor: pointer;
        }

        .btn-outline-purple:hover {
            background: #fafafc;
        }

        .btn-solid-purple {
            display: flex;
            align-items: center;
            gap: 8px;
            background: var(--purple);
            color: #fff;
            border: none;
            font-size: 13.5px;
            font-weight: 700;
            padding: 11px 18px;
            border-radius: 9px;
            cursor: pointer;
        }

        .btn-solid-purple a {
            text-decoration: none;
            color: #fff;
        }

        .btn-solid-purple:hover {
            opacity: 0.9;
        }

        /* ===== TOP PROFILE PANEL ===== */
        .panel {
            background: var(--white);
            border-radius: var(--radius);
            box-shadow: 0 1px 3px rgba(20, 20, 50, 0.04);
        }

        .profile-top {
            display: flex;
            align-items: center;
            gap: 28px;
            padding: 26px 30px;
            margin-bottom: 20px;
        }

        .profile-photo-wrap {
            position: relative;
            flex-shrink: 0;
        }

        .profile-photo {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            background: linear-gradient(135deg, #c9d3e0, #e4e9f0);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 44px;
            overflow: hidden;
        }

        .status-dot {
            position: absolute;
            bottom: 4px;
            right: 4px;
            width: 16px;
            height: 16px;
            border-radius: 50%;
            background: var(--green);
            border: 3px solid #fff;
        }

        .profile-top-mid {
            flex: 1;
            min-width: 220px;
        }

        .profile-top-name {
            font-size: 21px;
            font-weight: 800;
            margin-bottom: 8px;
        }

        .role-pill {
            display: inline-block;
            background: var(--purple-light);
            color: var(--purple);
            font-size: 12.5px;
            font-weight: 700;
            padding: 5px 14px;
            border-radius: 20px;
            margin-bottom: 14px;
        }

        .contact-row {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 13.5px;
            color: var(--text-dark);
            margin-bottom: 8px;
        }

        .contact-row .ci {
            color: var(--purple);
            width: 16px;
            text-align: center;
        }

        .profile-top-divider {
            width: 1px;
            align-self: stretch;
            background: var(--border);
            margin: 0 6px;
        }

        .kv-list {
            display: flex;
            flex-direction: column;
            gap: 12px;
            min-width: 260px;
        }

        .kv-row {
            display: flex;
            font-size: 13.5px;
        }

        .kv-key {
            width: 150px;
            color: var(--text-dark);
            font-weight: 600;
        }

        .kv-colon {
            width: 16px;
            color: var(--text-light);
        }

        .kv-val {
            color: var(--text-mid);
        }

        .status-active {
            display: inline-block;
            background: var(--green-light);
            color: #1f8a4d;
            font-size: 12px;
            font-weight: 700;
            padding: 4px 12px;
            border-radius: 16px;
        }

        /* ===== STAT CARDS ===== */
        .stats-row {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 18px;
            margin-bottom: 20px;
        }

        .stat-card {
            border-radius: var(--radius);
            padding: 20px 18px;
            cursor: pointer;
            transition: transform .12s ease;
            border: 1px solid transparent;
        }

        .stat-card:hover {
            transform: translateY(-2px);
        }

        .stat-card.blue {
            background: var(--blue-light);
        }

        .stat-card.green {
            background: var(--green-light);
        }

        .stat-card.purple {
            background: var(--purple-light);
        }

        .stat-card.amber {
            background: var(--amber-light);
        }

        .stat-top {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 14px;
        }

        .stat-icon {
            width: 42px;
            height: 42px;
            border-radius: 11px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            color: #fff;
            flex-shrink: 0;
        }

        .stat-icon.blue-bg {
            background: var(--blue);
        }

        .stat-icon.green-bg {
            background: var(--green);
        }

        .stat-icon.purple-bg {
            background: var(--purple);
        }

        .stat-icon.amber-bg {
            background: var(--amber);
        }

        .stat-label {
            font-size: 13.5px;
            font-weight: 700;
            color: var(--text-dark);
        }

        .stat-value {
            font-size: 25px;
            font-weight: 800;
            color: var(--text-dark);
            margin-bottom: 6px;
        }

        .stat-link {
            font-size: 12px;
            font-weight: 700;
            color: var(--text-mid);
        }

        /* ===== INFO GRID ===== */
        .info-grid-row {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin-bottom: 24px;
        }

        .info-panel {
            padding: 22px 24px;
        }

        .info-header {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 16px;
            padding-bottom: 14px;
            border-bottom: 1px solid var(--border);
        }

        .info-icon {
            color: var(--purple);
            font-size: 16px;
        }

        .info-header h3 {
            font-size: 15.5px;
            font-weight: 800;
        }

        .info-kv {
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        .info-kv-row {
            display: flex;
            font-size: 13.5px;
        }

        .info-kv-key {
            width: 105px;
            color: var(--text-dark);
            font-weight: 600;
            flex-shrink: 0;
        }

        .info-kv-colon {
            width: 14px;
            color: var(--text-light);
        }

        .info-kv-val {
            color: var(--text-mid);
        }

        .back-btn-wrap {
            display: flex;
            justify-content: center;
            margin-bottom: 10px;
        }

        .btn-back {
            display: flex;
            align-items: center;
            gap: 8px;
            background: #fff;
            color: var(--purple);
            border: 1.5px solid var(--purple);
            font-size: 14px;
            font-weight: 700;
            padding: 12px 26px;
            border-radius: 9px;
            cursor: pointer;
        }

        .btn-back a {
            text-decoration: none;
            color: var(--purple);
        }

        .btn-back:hover {
            background: var(--purple-light);
        }

        footer {
            text-align: center;
            padding: 20px;
            font-size: 13px;
            color: var(--text-light);
            margin-top: auto;
        }

        .toast {
            position: fixed;
            bottom: 26px;
            left: 50%;
            transform: translateX(-50%) translateY(20px);
            background: var(--navy);
            color: #fff;
            padding: 13px 22px;
            border-radius: 10px;
            font-size: 13.5px;
            font-weight: 600;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
            opacity: 0;
            pointer-events: none;
            transition: all .25s ease;
            z-index: 2000;
        }

        .toast.show {
            opacity: 1;
            transform: translateX(-50%) translateY(0);
        }

        @media(max-width:1100px) {
            .stats-row {
                grid-template-columns: 1fr 1fr;
            }

            .info-grid-row {
                grid-template-columns: 1fr;
            }
        }

        @media(max-width:900px) {
            .sidebar {
                position: fixed;
                top: 0;
                left: 0;
                height: 100vh;
                transform: translateX(-100%);
                box-shadow: 0 0 30px rgba(0, 0, 0, 0.25);
            }

            .sidebar.open {
                transform: translateX(0);
            }

            .sidebar-close {
                display: block;
            }
        }

        @media(max-width:768px) {
            .profile-top {
                flex-direction: column;
                align-items: flex-start;
            }

            .profile-top-divider {
                display: none;
            }

            .kv-list {
                width: 100%;
            }
        }

        @media(max-width:640px) {
            .content {
                padding: 18px 16px 32px;
            }

            .topbar {
                padding: 14px 18px;
            }

            .stats-row {
                grid-template-columns: 1fr 1fr;
            }

            .user-name,
            .user-role {
                display: none;
            }

            .header-actions {
                width: 100%;
            }

            .btn-outline-purple,
            .btn-solid-purple {
                flex: 1;
                justify-content: center;
            }
        }
    </style>
</head>

<body>

    <div class="sidebar-overlay" id="sidebarOverlay" onclick="closeSidebar()"></div>

    <aside class="sidebar" id="sidebar">
        <button class="sidebar-close" onclick="closeSidebar()">✕</button>
        <div class="brand">
            <div class="brand-icon">🤝</div>
            <div class="brand-text">
                <h1>Apna Sahara</h1>
                
            </div>
        </div>

        <nav>
            <div class="nav-item " data-page="Dashboard"><a href="/adminDashboard"> 🏠 Dashboard</a></div>

            <div class="menu-label">MANAGEMENT</div>
            <div class="nav-item" data-page="Donations"><a href="/adminDonation"> 📋 Donations</a></div>
            <div class="nav-item" data-page="Donation Requests"><a href="/donationreq"> 📄 Donation Requests</a>
            </div>
            <div class="nav-item" data-page="Organizations"><a href="/adminOrg"> 🏛 Organizations </a></div>
            <div class="nav-item" data-page="Donors / Users"><a href="/donor">👥 Donors / Users</a></div>
            <div class="nav-item" data-page="Donation Categories"><a href="/donateCat"> 📑 Donation Categories</a>
            </div>
        </nav>
    </aside>

    <!-- ✅ .main now wraps the topbar, content AND footer, so they stack in one flex column
         instead of sitting beside it as separate flex-row items (that mismatch was what
         caused the content to visually collapse into the footer). -->
    <div class="main">
        <div class="topbar">
            <div class="top-left">
                <div class="hamburger" onclick="openSidebar()">☰</div>
                <div class="top-title" id="topTitle">Admin Dashboard</div>
            </div>
            <div class="top-right">
                <div class="bell-wrap" onclick="toggleDropdown('notifDropdown')">
                    🔔<span class="bell-dot">5</span>
                    <div class="dropdown-panel" id="notifDropdown">
                        <div class="dropdown-title">Notifications</div>
                        <div class="notif-item">
                            <p>New donation request from Smile Orphanage</p><span>10 mins ago</span>
                        </div>
                        <div class="notif-item">
                            <p>Rahul Mehta submitted a donation</p><span>1 hour ago</span>
                        </div>
                        <div class="notif-item">
                            <p>Gokul Gaushala request accepted</p><span>2 hours ago</span>
                        </div>
                        <div class="notif-item">
                            <p>New organization registered</p><span>3 hours ago</span>
                        </div>
                        <div class="notif-item">
                            <p>Monthly report is ready</p><span>5 hours ago</span>
                        </div>
                    </div>
                </div>
                <div class="user-block" onclick="toggleDropdown('userDropdown')">
                    <div class="avatar">👤</div>
                    <div>
                        <div class="user-name">
                            <%= loggedInUserName %>
                        </div>
                        <div class="user-role">
                            <%= loggedInUserRole %>
                        </div>
                    </div>
                    <span class="chev">▾</span>
                    <div class="dropdown-panel user-menu" id="userDropdown">
                        <div class="user-menu-item" onclick="showToast('Opening profile...')"><a href="/adminProfile">
                                👤 My Profile</a></div>
                        <div class="user-menu-item danger"> <a href="/logout"> ↪ Logout</a></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="content">

            <div id="profilePage">

                <div class="page-header">
                    <div>
                        <h1>Admin Profile</h1>
                        <div class="breadcrumb">Dashboard &nbsp;›&nbsp; <span>Profile</span></div>
                    </div>
                    <div class="header-actions">

                        <button class="btn-solid-purple"><a href="/adminEditProfile"> ✎ Edit Profile</a></button>
                    </div>
                </div>

                <div class="panel profile-top">
                    <div class="profile-photo-wrap">
                        <div class="profile-photo" id="avatarDisplay">🧑‍💼</div>
                        <div class="status-dot"></div>
                    </div>

                    <div class="profile-top-mid">
                        <div class="profile-top-name" id="displayName">
                            <%= admin ? admin.fullName : 'Not set' %>
                        </div>
                        <div class="role-pill">Super Administrator</div>
                        <div class="contact-row"><span class="ci">✉</span> <span id="displayEmail">
                                <%= admin ? admin.email : 'Not set' %>
                            </span></div>
                        <div class="contact-row"><span class="ci">📞</span> <span id="displayPhone">
                                <%= admin ? admin.phone : 'Not set' %>
                            </span></div>
                        <div class="contact-row"><span class="ci">📍</span> <span id="displayLocation">
                                <%= admin ? admin.address : 'Not set' %>
                            </span></div>
                    </div>

                    <div class="profile-top-divider"></div>

                    <div class="kv-list">
                        <div class="kv-row">
                            <div class="kv-key">Admin ID</div>
                            <div class="kv-colon">:</div>
                            <div class="kv-val"><%= admin.adminID %></div>
                        </div>
                        <div class="kv-row">
                            <div class="kv-key">Role</div>
                            <div class="kv-colon">:</div>
                            <div class="kv-val"><%= admin.role %></div>
                        </div>
                        <div class="kv-row">
                            <div class="kv-key">Account Created On</div>
                            <div class="kv-colon">:</div>
                            <div class="kv-val"><%= new Date(admin.createdAt).toLocaleDateString() %></div>
                        </div>
                        
                        <div class="kv-row">
                            <div class="kv-key">Status</div>
