    <div class="toast" id="toast"></div>

    <script>
        /* ---------- SIDEBAR ---------- */
        const sidebar = document.getElementById('sidebar');
        const overlay = document.getElementById('sidebarOverlay');
        function openSidebar() { sidebar.classList.add('open'); overlay.classList.add('open'); }
        function closeSidebar() { sidebar.classList.remove('open'); overlay.classList.remove('open'); }
        window.addEventListener('resize', () => { if (window.innerWidth > 900) closeSidebar(); });

        const navIcons = {
            'Dashboard': '🏠', 'Donations': '📋', 'Donation Requests': '📄', 'Organizations': '🏛',
            'Donors / Users': '👥', 'Donation Categories': '📑', 'Reports & Statistics': '📈',
            'Settings': '⚙', 'Logout': '↪'
        };

        function selectNav(el) {
            document.querySelectorAll('.nav-item').forEach(i => i.classList.remove('active'));
            el.classList.add('active');
            const page = el.getAttribute('data-page');
            renderPage(page);
            if (window.innerWidth <= 900) closeSidebar();
        }

        function goTo(pageName) {
            const el = document.querySelector(`.nav-item[data-page="${pageName}"]`);
            if (el) { selectNav(el); window.scrollTo({ top: 0, behavior: 'smooth' }); }
        }

        function renderPage(page) {
            const profilePage = document.getElementById('profilePage');
            const placeholderPage = document.getElementById('placeholderPage');
            document.getElementById('topTitle').textContent = page === 'Dashboard' ? 'Admin Dashboard' : page;

            if (page === 'Dashboard') {
                window.location.href = '/adminDashboard';
            } else if (page === 'Logout') {
                showToast('Logging out...');
                window.location.href = '/logout';
            } else {
                profilePage.style.display = 'none';
                placeholderPage.style.display = 'block';
                document.getElementById('placeholderIcon').textContent = navIcons[page] || '📄';
                document.getElementById('placeholderTitle').textContent = page;
            }
        }

        /* ---------- DROPDOWNS ---------- */
        function toggleDropdown(id) {
            const el = document.getElementById(id);
            const isOpen = el.classList.contains('open');
            document.querySelectorAll('.dropdown-panel').forEach(d => d.classList.remove('open'));
            if (!isOpen) el.classList.add('open');
        }
        document.addEventListener('click', (e) => {
            if (!e.target.closest('.bell-wrap') && !e.target.closest('.user-block')) {
                document.querySelectorAll('.dropdown-panel').forEach(d => d.classList.remove('open'));
            }
        });

        /* ---------- TOAST ---------- */
        let toastTimer;
        function showToast(msg) {
            const toast = document.getElementById('toast');
            toast.textContent = msg;
            toast.classList.add('show');
            clearTimeout(toastTimer);
            toastTimer = setTimeout(() => toast.classList.remove('show'), 2200);
        }
    </script>

</body>

</html>