<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Apna Sahara - Edit Profile</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --navy: #111a3d;
            --purple: #6f5bf0;
            --purple-light: #eeeafd;
            --blue: #2f7bf6;
            --blue-light: #e7f0fe;
            --amber: #f5a623;
            --amber-light: #fdf1de;
            --green: #28b463;
            --green-light: #e6f7ec;
            --pink: #e0447a;
            --pink-light: #fbe7ef;
            --teal: #17b697;
            --gray: #8b93a7;
            --gray-light: #eef0f4;
            --text-dark: #1c2333;
            --text-mid: #5b6478;
            --text-light: #8b93a7;
            --border: #eef0f4;
            --bg: #f5f6fa;
            --white: #ffffff;
            --radius: 14px;
        }
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }
        body {
            font-family: 'Inter', sans-serif;
            background: var(--bg);
            color: var(--text-dark);
            display: flex;
            min-height: 100vh;
        }
        button {
            font-family: inherit;
        }
        /* ===== SIDEBAR ===== */
        .sidebar-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(10, 13, 30, 0.5);
            z-index: 1000;
        }
        .sidebar-overlay.open {
            display: block;
        }
        .sidebar {
            width: 264px;
            background: var(--navy);
            color: #cfd3e6;
            display: flex;
            flex-direction: column;
            padding: 22px 18px;
            flex-shrink: 0;
            transition: transform .28s ease;
            z-index: 1001;
            max-height: 100vh;
            overflow-y: auto;
        }
        .sidebar-close {
            display: none;
            align-self: flex-end;
            font-size: 20px;
            color: #9aa1c2;
            background: none;
            border: none;
            cursor: pointer;
            margin-bottom: 4px;
        }
        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 0 6px 22px 6px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            margin-bottom: 18px;
        }
        .brand-icon {
            width: 42px;
            height: 42px;
            background: #fff;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            flex-shrink: 0;
        }
        .brand-text h1 {
            font-size: 15px;
            color: #fff;
            font-weight: 700;
            line-height: 1.3;
        }
        .brand-text p {
            font-size: 12px;
            color: #9aa1c2;
        }
        .menu-label {
            font-size: 11px;
            letter-spacing: 0.06em;
            color: #7981a6;
            font-weight: 700;
            margin: 14px 10px 8px;
        }
        nav {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }
        .nav-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 11px 14px;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 500;
            color: #c3c8de;
            cursor: pointer;
            transition: background .15s ease;
            position: relative;
        }
        .nav-item a {
            color: white;
            text-decoration: none;
        }
        .nav-item:hover {
            background: rgba(255, 255, 255, 0.06);
        }
        .nav-item.active {
            background: var(--purple);
            color: #fff;
            font-weight: 600;
        }
        /* ===== MAIN ===== */
        .main {
            flex: 1;
            display: flex;
            flex-direction: column;
            min-width: 0;
        }
        .topbar {
            background: var(--white);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 16px 32px;
            border-bottom: 1px solid var(--border);
            position: relative;
            z-index: 50;
        }
        .top-left {
            display: flex;
            align-items: center;
            gap: 20px;
        }
        .hamburger {
            font-size: 20px;
            color: var(--text-mid);
            cursor: pointer;
        }
        .top-title {
            font-size: 19px;
            font-weight: 800;
            color: var(--text-dark);
        }
        .top-right {
            display: flex;
            align-items: center;
            gap: 22px;
            position: relative;
        }
        .bell-wrap {
            position: relative;
            font-size: 19px;
            color: var(--text-mid);
            cursor: pointer;
        }
        .bell-dot {
            position: absolute;
            top: -6px;
            right: -8px;
            background: #e0447a;
            color: #fff;
            font-size: 10px;
            font-weight: 700;
            width: 16px;
            height: 16px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .user-block {
            display: flex;
            align-items: center;
            gap: 10px;
            cursor: pointer;
        }
        .avatar {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: var(--purple);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 14px;
        }
        .user-name {
            font-size: 14px;
            font-weight: 700;
            color: var(--text-dark);
        }
        .user-role {
            font-size: 12px;
            color: var(--text-light);
        }
        .chev {
            color: var(--text-light);
            font-size: 11px;
            margin-left: 2px;
        }
        .content {
            padding: 26px 32px 40px;
        }
        /* ===== PAGE HEADER ===== */
        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 20px;
            flex-wrap: wrap;
            gap: 14px;
        }

        .page-header h1 {
            font-size: 26px;
            font-weight: 800;
            margin-bottom: 6px;
        }

        .breadcrumb {
            font-size: 13.5px;
            color: var(--text-light);
        }

        .breadcrumb span {
            color: var(--text-dark);
            font-weight: 600;
        }

        .btn-outline-purple {
            display: flex;
            align-items: center;
            gap: 8px;
            background: #fff;
            color: var(--text-dark);
            border: 1.5px solid #d8dbe6;
            font-size: 13.5px;
            font-weight: 700;
            padding: 11px 18px;
            border-radius: 9px;
            cursor: pointer;
            text-decoration: none;
        }

        .btn-outline-purple:hover {
            background: #fafafc;
        }

        .btn-solid-purple {
            display: flex;
            align-items: center;
            gap: 8px;
            background: var(--purple);
            color: #fff;
            border: none;
            font-size: 13.5px;
            font-weight: 700;
            padding: 11px 18px;
            border-radius: 9px;
            cursor: pointer;
        }

        .btn-solid-purple:hover {
            opacity: 0.9;
        }

        .btn-solid-purple:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

        /* ===== FORM PANEL ===== */
        .panel {
            background: var(--white);
            border-radius: var(--radius);
            box-shadow: 0 1px 3px rgba(20, 20, 50, 0.04);
        }

        .form-panel {
            max-width: 780px;
            margin: 0 auto;
            padding: 30px 34px 34px;
        }

        .form-section-title {
            font-size: 14px;
            font-weight: 800;
            color: var(--text-dark);
            margin: 26px 0 16px;
            padding-bottom: 10px;
            border-bottom: 1px solid var(--border);
        }

        .form-section-title:first-of-type {
            margin-top: 0;
        }

        .photo-row {
            display: flex;
            align-items: center;
            gap: 20px;
            margin-bottom: 8px;
        }

        .photo-preview {
            width: 84px;
            height: 84px;
            border-radius: 50%;
            background: linear-gradient(135deg, #c9d3e0, #e4e9f0);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 34px;
            flex-shrink: 0;
            overflow: hidden;
        }

        .photo-preview img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .photo-actions {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }
        .photo-actions p {
            font-size: 12px;
            color: var(--text-light);
        }
        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px 20px;
        }
        .form-grid .full {
            grid-column: 1 / -1;
        }
        .form-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }
        .form-group label {
            font-size: 13px;
            font-weight: 700;
            color: var(--text-dark);
        }
        .form-group .req {
            color: var(--pink);
        }
        .form-group input,
        .form-group select {
            border: 1.5px solid var(--border);
            border-radius: 9px;
            padding: 11px 13px;
            font-size: 13.5px;
            font-family: inherit;
            outline: none;
            background: #fbfbfd;
            color: var(--text-dark);
            width: 100%;
        }

        .form-group input:focus,
        .form-group select:focus {
            border-color: var(--purple);
            background: #fff;
        }

        .form-hint {
            font-size: 11.5px;
            color: var(--text-light);
        }

        .form-error {
            font-size: 11.5px;
            color: var(--pink);
            display: none;
        }

        .form-group.invalid input,
        .form-group.invalid select {
            border-color: var(--pink);
            background: var(--pink-light);
        }

        .form-group.invalid .form-error {
            display: block;
        }

        .form-actions {
            display: flex;
            justify-content: flex-end;
            gap: 12px;
            margin-top: 30px;
            padding-top: 22px;
            border-top: 1px solid var(--border);
        }

        footer {
            text-align: center;
            padding: 20px;
            font-size: 13px;
            color: var(--text-light);
        }

        .toast {
            position: fixed;
            bottom: 26px;
            left: 50%;
            transform: translateX(-50%) translateY(20px);
            background: var(--navy);
            color: #fff;
            padding: 13px 22px;
            border-radius: 10px;
            font-size: 13.5px;
            font-weight: 600;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
            opacity: 0;
            pointer-events: none;
            transition: all .25s ease;
            z-index: 2000;
        }

        .toast.show {
            opacity: 1;
            transform: translateX(-50%) translateY(0);
        }

        @media(max-width:900px) {
            .sidebar {
                position: fixed;
                top: 0;
                left: 0;
                height: 100vh;
                transform: translateX(-100%);
                box-shadow: 0 0 30px rgba(0, 0, 0, 0.25);
            }

            .sidebar.open {
                transform: translateX(0);
            }

            .sidebar-close {
                display: block;
            }
        }

        @media(max-width:640px) {
            .content {
                padding: 18px 16px 32px;
            }

            .topbar {
                padding: 14px 18px;
            }

            .form-panel {
                padding: 22px 18px 26px;
            }

            .form-grid {
                grid-template-columns: 1fr;
            }

            .user-name,
            .user-role {
                display: none;
            }
        }
    </style>
</head>

<body>

    <div class="sidebar-overlay" id="sidebarOverlay" onclick="closeSidebar()"></div>

    <aside class="sidebar" id="sidebar">
        <button class="sidebar-close" onclick="closeSidebar()">✕</button>
        <div class="brand">
            <div class="brand-icon">🤝</div>
            <div class="brand-text">
                <h1>Apna Sahara</h1>
                <!-- <p>Management System</p> -->
            </div>
        </div>

        <nav>
            <div class="nav-item " data-page="Dashboard"><a href="/adminDashboard"> 🏠 Dashboard</a></div>

            <div class="menu-label">MANAGEMENT</div>
            <div class="nav-item" data-page="Donations"><a href="/adminDonation"> 📋</span>
                    Donations</a></div>
            <div class="nav-item" data-page="Donation Requests"><a href="/donationreq"> 📄 Donation Requests</a>
            </div>
            <div class="nav-item" data-page="Organizations"><a href="/adminOrg"> 🏛 Organizations </a></div>
            <div class="nav-item" data-page="Donors / Users"><a href="/donor">👥 Donors / Users</a></div>
            <div class="nav-item" data-page="Donation Categories"><a href="/donateCat"> 📑 Donation Categories</a>
            </div>
        </nav>
    </aside>

    <div class="main">
        <div class="topbar">
            <div class="top-left">
                <div class="hamburger" onclick="openSidebar()">☰</div>
                <div class="top-title">Edit Profile</div>
            </div>
            <div class="top-right">
                <div class="bell-wrap">🔔<span class="bell-dot">5</span></div>
                <div class="user-block">
                    <div class="avatar">👤</div>
                    <div>
                        <div class="user-name">
                            <%= loggedInUserName %>
                        </div>
                        <div class="user-role">
                            <%= loggedInUserRole %>
                        </div>
                    </div>
                    <span class="chev">▾</span>
                </div>
            </div>
        </div>

        <div class="content">
            <div class="page-header">
                <div>
                    <h1>Edit Profile</h1>
                    <div class="breadcrumb">Dashboard / My Profile / <span>Edit</span></div>
                </div>
                <a href="/adminProfile" class="btn-outline-purple">← Back to Profile</a>
            </div>

            <div class="panel form-panel">
                <form id="editForm" action="/adminEditProfile" method="POST">

                    <div class="form-section-title">Profile Photo</div>
                    <div class="photo-row">
                        <div class="photo-preview" id="photoPreview">
                            <span id="photoPlaceholder">👤</span>
                        </div>
                        <div class="photo-actions">
                            <label class="btn-outline-purple" style="cursor:pointer;">
                                Change Photo
                                <input type="file" name="photo" id="photoInput" accept="image/*" style="display:none;">
                            </label>
                            <p>JPG or PNG, up to 2MB</p>
                        </div>
                    </div>

                    <div class="form-section-title">Personal Information</div>
                    <div class="form-grid">
                        <div class="form-group">
                            <label>Full Name <span class="req">*</span></label>
                            <input type="text" name="fullName" id="fullName" value="<%= admin ? admin.fullName : '' %>" required>
                            <span class="form-error">Please enter your full name.</span>
                        </div>
                        <div class="form-group">
                            <label>Email Address <span class="req">*</span></label>
                            <input type="email" name="email" id="email" value="<%= admin ? admin.email : '' %>" required>
                            <span class="form-error">Please enter a valid email address.</span>
                        </div>
                        <div class="form-group">
                            <label>Phone Number <span class="req">*</span></label>
                            <input type="tel" name="phone" id="phone" value="<%= admin ? admin.phone : '' %>" placeholder="e.g. 9876543210" required>
                            <span class="form-error">Please enter a valid phone number.</span>
                        </div>
                        <div class="form-group">
                            <label>Date of Birth</label>
                            <input type="date" name="dateOfBirth" id="dob" value="<%= admin ? admin.dateOfBirth : '' %>">
                        </div>
                        <div class="form-group full">
                            <label>Gender</label>
                            <select name="gender" id="gender">
                                <option value="">Select gender</option>
                                <option value="Male" <%= admin && admin.gender === 'Male' ? 'selected' : '' %>>Male</option>
                                <option value="Female" <%= admin && admin.gender === 'Female' ? 'selected' : '' %>>Female</option>
                                <option value="Other" <%= admin && admin.gender === 'Other' ? 'selected' : '' %>>Other</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-section-title">Address</div>
                    <div class="form-grid">
                        <div class="form-group full">
                            <label>Address</label>
                            <input type="text" name="address" id="address" value="<%= admin ? admin.address : '' %>">
                        </div>
                        <div class="form-group">
                            <label>City</label>
                            <input type="text" name="city" id="city" value="<%= admin ? admin.city : '' %>">
                        </div>
                        <div class="form-group">
                            <label>State</label>
                            <input type="text" name="state" id="state" value="<%= admin ? admin.state : '' %>">
                        </div>
                        <div class="form-group">
                            <label>Country</label>
                            <input type="text" name="country" id="country" value="<%= admin ? admin.country : '' %>">
                        </div>
                        <div class="form-group">
                            <label>Pincode</label>
                            <input type="text" name="pincode" id="pincode" value="<%= admin ? admin.pincode : '' %>">
                            <span class="form-hint">6-digit postal code</span>
                        </div>
                    </div>

                    <div class="form-actions">
                        <a href="profile.html" class="btn-outline-purple">Cancel</a>
                        <button type="submit" class="btn-solid-purple" id="saveBtn">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>

        <footer>© 2026 Apna Sahara. All rights reserved.</footer>
    </div>

    <div class="toast" id="toast"></div>

    <script>
        

    /* ---------- SIDEBAR ---------- */
    const sidebar = document.getElementById('sidebar');
    const overlay = document.getElementById('sidebarOverlay');
    function openSidebar() { sidebar.classList.add('open'); overlay.classList.add('open'); }
    function closeSidebar() { sidebar.classList.remove('open'); overlay.classList.remove('open'); }
    window.addEventListener('resize', () => { if (window.innerWidth > 900) closeSidebar(); });

    /* ---------- TOAST ---------- */
    let toastTimer;
    function showToast(msg) {
        const toast = document.getElementById('toast');
        toast.textContent = msg;
        toast.classList.add('show');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => toast.classList.remove('show'), 2200);
    }

    /* ---------- PHOTO PREVIEW ---------- */
    document.getElementById('photoInput').addEventListener('change', function (e) {
        const file = e.target.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = function (ev) {
            document.getElementById('photoPreview').innerHTML = `<img src="${ev.target.result}" alt="Profile photo">`;
        };
        reader.readAsDataURL(file);
    });

    /* ---------- VALIDATION ---------- */
    function setError(id, isInvalid) {
        const group = document.getElementById(id).closest('.form-group');
        group.classList.toggle('invalid', isInvalid);
    }

    function validateForm() {
        let valid = true;

        const fullName = document.getElementById('fullName').value.trim();
        if (!fullName) { setError('fullName', true); valid = false; } 
        else { setError('fullName', false); }

        const email = document.getElementById('email').value.trim();
        const emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
        if (!emailOk) { setError('email', true); valid = false; } 
        else { setError('email', false); }

        const phone = document.getElementById('phone').value.trim();
        const phoneOk = /^[0-9]{7,15}$/.test(phone.replace(/[\s-]/g, ''));
        if (!phoneOk) { setError('phone', true); valid = false; } 
        else { setError('phone', false); }

        return valid;
    }

    /* ---------- REAL FORM SUBMIT ---------- */
    document.getElementById('editForm').addEventListener('submit', function (e) {
        if (!validateForm()) {
            e.preventDefault();
            showToast('Please fix the highlighted fields.');
            return;
        }

        const saveBtn = document.getElementById('saveBtn');
        saveBtn.disabled = true;
        saveBtn.textContent = 'Saving...';
        // IMPORTANT:
        // Do NOT use e.preventDefault() here.
        // Let the form submit normally to /adminEditProfile
    });
    </script>
</body>
</html>